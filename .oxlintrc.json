{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "jsdoc", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    // TSDoc carries @param and @returns only where they add to the types.
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-returns-type": "off",
    "jsdoc/require-param-type": "off",
    // Vortex hands the extension mutable objects (the context, its API) that it owns.
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/explicit-member-accessibility": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/explicit-function-return-type": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "max-classes-per-file": ["error", 1],
    "max-depth": ["error", 4],
    "no-console": "error",
    "no-restricted-globals": ["error", "Boolean"]
  },
  "overrides": [
    // A test file is one describe block with a case per behaviour; its length is the list of cases.
    {
      "files": ["**/__tests__/**"],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**"]
}
