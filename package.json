{
  "name": "enshwick-vortex-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Vortex extension that installs Enshwick and its mods into Enshrouded",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun tools/build.ts",
    "check": "tsc && oxfmt --check && oxlint && markdownlint-cli2 && bun --bun vitest run",
    "package": "bun tools/build.ts --package"
  },
  "dependencies": {
    "@horizon-republic/nominal-types": "3.1.0"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "2.10.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "65.4.5",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "re-reselect": "6.0.0",
    "reselect": "5.3.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  }
}
